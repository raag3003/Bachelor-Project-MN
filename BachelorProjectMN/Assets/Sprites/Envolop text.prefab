  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "K\xE6re rekrut\nVi beklager den mist\xE6nksomme besked. Men vi bliver
    n\xF8d til at f\xE5 fat i dig inden du begynder p\xE5 din f\xF8rste artikel\nVi
    kommer fra modstands gruppen der k\xE6mper mod statens forf\xE6rdlige styresystem\n\nVi
    har f\xE5et beviser for at statens politi er korrupt og ulovligt. 2 af dine af
    jounalister er med os og har lavet artikel sectioner som der fort\xE6ller den
    sande nyhed.\n\nVi h\xE5ber du vil fort\xE6lle folket hvad staten faktisk g\xF8r
    mod sin egen befolkning\n\nVi kontakter dig nok igen\nViva la revolution - Modstandsgrubben"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
