    - target: {fileID: 997486038795548296, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_text
      value: "REKRUT!!!!!\nHer i NEK har vi ingen tolorance for l\xF8gn i vores artikler.
        Korrupt politi?! Hvad t\xE6nker du p\xE5?!\n\nIkke desto mindre.  S\xE5 har
        i bestyrelsen besluttet at give dig en chance mere og fort\xE6lle folket
        den rigtige historie der for stoppet disse un\xF8dvendige demonstrationer
        du uden tvilv har h\xF8rt om.\n\nVores indre efterforskings i firmaet har
        ogs\xE5 opdaget nogle potientielle mulvapper. Vi fort\xE6ller n\xE6rmere
        n\xE5r vi ved mere. Du skal bare skrive den rigtige historie herfra.\n\nG\xF8r
        dit arbejde. Hilsen NEK og staten"
      objectReference: {fileID: 0}
    - target: {fileID: 4352676986115181501, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_text
      value: Dag 2
      objectReference: {fileID: 0}
    - target: {fileID: 4792322263681072638, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_Name
      value: Start day paper
      objectReference: {fileID: 0}
    - target: {fileID: 4792322263681072638, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
