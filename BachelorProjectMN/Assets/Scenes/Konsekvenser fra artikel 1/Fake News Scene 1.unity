    - target: {fileID: 997486038795548296, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_text
      value: "Hej igen rekrut.\nVi her i NEK er meget glad for dit sammerbejde i
        forhold til den tidligere artikel du sendte videre i g\xE5r.\nStaten har
        gjort os opm\xE6rksom p\xE5 at nogle af vores journalister arbejder imod
        staten, men vi pr\xF8ver at finde dem og f\xE5 dem fyret s\xE5 hurtigt som
        muligt.\nSkulle du h\xF8rer noget om en modstandsgrubbe, s\xE5 m\xE5 du endelige
        sige til.\n\nH\xE5ber du holder det gode arbejde i dag."
      objectReference: {fileID: 0}
    - target: {fileID: 4262348692299821275, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: -1026305052520368857, guid: a591e4009588d114690f29cdff589d19, type: 3}
    - target: {fileID: 4352676986115181501, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_text
      value: Dag 2. Godt arbejde
      objectReference: {fileID: 0}
    - target: {fileID: 4792322263681072638, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_Name
      value: Start day paper
      objectReference: {fileID: 0}
