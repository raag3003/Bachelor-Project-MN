    - target: {fileID: 997486038795548296, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_text
      value: "P\xE6nt goddag rekrut\nDin artikel i g\xE5r var... sp\xE6ndende. At
        lyve omkring korrupt politi er en sp\xE6ndende taktik p\xE5 f\xF8rste dag.
        Men s\xE5 igen. Det bragte en masse l\xE6sere til, s\xE5 det er ikke noget
        problem.\n\nDog vil jeg gerne minde dig om at vi bor i det bedste land p\xE5
        jorden. Der er ingen grund til at lyve over for befolkningen.\n\nHav en god
        arbejdsdag. Husk at staten ogs\xE5 l\xE6ser nyhederne"
      objectReference: {fileID: 0}
    - target: {fileID: 1260669088995609290, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_SizeDelta.x
      value: 1709.2026
      objectReference: {fileID: 0}
    - target: {fileID: 1260669088995609290, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 7.6217
      objectReference: {fileID: 0}
    - target: {fileID: 4352676986115181501, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_text
      value: 'Dag 2 '
      objectReference: {fileID: 0}
    - target: {fileID: 4792322263681072638, guid: 8889eb9bd54f0484bb4625743958eedb, type: 3}
      propertyPath: m_Name
      value: Start day paper
      objectReference: {fileID: 0}
